DB_URL=jdbc:mysql://localhost:3306/marmitassousa?useSSL=false&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=change-me
PDV_LOGIN_USERNAME=change-me
PDV_LOGIN_PASSWORD=change-me
# Nome exato da impressora térmica usada para imprimir comandas
IMPRESSORA_TERMICA=termica
# "local" imprime nesta máquina; "ponte" delega para a ponte da loja
IMPRESSAO_MODO=local
MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
# URL pública (HTTPS) do webhook. Em dev, use um túnel: ngrok http 8080
MERCADO_PAGO_WEBHOOK_URL=https://seu-tunel.ngrok.io/webhook/mercadopago
# Secret para validar a assinatura das notificações (header x-signature). Vazio = não valida.
MERCADO_PAGO_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve apontar para a MESMA porta onde o app roda (padrão 8080) e estar
# cadastrado em "Authorized redirect URIs" no Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8080/site/google/callback
GEOAPIFY_API_KEY=
# iFood (integração de pedidos). Credenciais do portal iFood Developer.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=
# "polling" puxa pedidos da iFood a cada intervalo; "webhook" recebe push da iFood.
IFOOD_MODO=polling
# 99Food (marketplace). Credenciais do developer99.
N99_APP_ID=
N99_SECRET=
# ID da loja no sistema (app_shop_id, exigido na autenticação).
N99_SHOP_ID=
# Host da API 99Food (Didi Food).
N99_BASE_URL=https://openapi.didi-food.com
# "polling" puxa pedidos da 99Food; "webhook" recebe push (não implementado).
N99_MODO=polling
# Secret para validar a assinatura das notificações (se a 99 fornecer). Vazio = não valida.
N99_WEBHOOK_SECRET=
